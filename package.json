{
  "name": "galactica",
  "version": "1.2.0",
  "description": "Build terminal dashboards using ascii/ansi art and javascript",
  "keywords": [
    "terminal",
    "dashboard",
    "cli",
    "ascii",
    "ansi",
    "tui",
    "console",
    "charts",
    "widgets",
    "blessed"
  ],
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --experimental-test-coverage --test test/*.test.js test/*.test.mjs",
    "test:coverage": "node test/coverage-report.js",
    "test:lint": "npm run lint",
    "release": "bash scripts/publish.sh",
    "lint": "eslint lib",
    "lint:fix": "eslint lib --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codemeasandwich/CliUI.git"
  },
  "author": "Brian Shannon (https://www.linkedin.com/in/brianshann/)",
  "license": "MIT",
  "devDependencies": {
    "@types/blessed": "^0.1.6",
    "eslint": "^5.11.0",
    "eslint-config-standard": "^12.0.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-node": "^8.0.0",
    "eslint-plugin-promise": "^4.0.1",
    "eslint-plugin-standard": "^4.0.0"
  },
  "dependencies": {
    "ansi-term": ">=0.0.2",
    "drawille-canvas-blessed-contrib": ">=0.1.3",
    "map-canvas": ">=0.1.5",
    "marked": "^4.0.12",
    "marked-terminal": "^5.1.1",
    "picture-tuber": "^1.0.1"
  }
}
